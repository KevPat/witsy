  "so.research_decision.openai.response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "research_decision",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "continue",
              "done"
            ],
            "description": "Status: continue with work or done (complete)"
          },
          "nextAction": {
            "type": "string",
            "nullable": true,
            "description": "Human-readable description of next action"
          },
          "agentName": {
            "type": "string",
            "nullable": true,
            "description": "Which deepresearch agent to call: planning, search, analysis, writer, title, or synthesis"
          },
          "agentParamsJson": {
            "type": "string",
            "nullable": true,
            "description": "JSON string containing parameters to pass to the agent. Can include '_relevantMemory' field. Example: {\"userQuery\":\"...\",\"_relevantMemory\":[\"id1\"]}"
          },
          "reasoning": {
            "type": "string",
            "description": "Explanation of decision and current progress"
          },
          "estimatedRemaining": {
            "type": "number",
            "nullable": true,
            "description": "Estimated number of remaining actions (helps with progress tracking)"
          },
          "deliveryMessage": {
            "type": "string",
            "nullable": true,
            "description": "Summary message when status='done'"
          }
        },
        "required": [
          "status",
          "nextAction",
          "agentName",
          "agentParamsJson",
          "reasoning",
          "estimatedRemaining",
          "deliveryMessage"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  },
